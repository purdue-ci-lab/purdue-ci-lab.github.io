  author      = {Nousias*, Sotiris and Wei*, Mian and Xiao, Howard and Wu, Maxx and Athar, Shahmeer and Wang, Kevin J. and Malik, Anagh and Barmherzig, David A. and Lindell, David B. and Kutulakos, Kiriakos N.},
  booktitle   = {Proceedings of the IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year        = {2025},
  tags        = {time-of-flight, opportunistic-sensing, 3d-reconstruction},
  website     = {https://www.dgp.toronto.edu/projects/opportunistic/},
  pdf         = {https://openaccess.thecvf.com/content/CVPR2025/papers/Nousias_Opportunistic_Single-Photon_Time_of_Flight_CVPR_2025_paper.pdf},
  supp        = {https://openaccess.thecvf.com/content/CVPR2025/supplemental/Nousias_Opportunistic_Single-Photon_Time_CVPR_2025_supplemental.zip},
  video       = {https://www.dgp.toronto.edu/projects/opportunistic/static/docs/supp/supp.mp4},
