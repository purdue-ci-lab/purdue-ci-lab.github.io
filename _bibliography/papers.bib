@inproceedings{yan2026spatiotemporal,
  abbr        = {ECCV},
  bibtex_show = {true},
  selected    = {true},
  title       = {Spatiotemporal Flux Probing for Single-Photon Videography},
  author      = {Yan*, Jerry and Forlivesi*, Matteo and Tan, Bowen and Xie, Andrew and Somasundaram, Siddharth and Nousias, Sotiris},
  booktitle   = {Proceedings of the European Conference on Computer Vision (ECCV)},
  year        = {2026},
  tags        = {high-speed-videography, low-light-imaging},
  preview     = {sptfluxprobe_preview.gif},
  website     = {https://jerukan.github.io/spt-flux-probing/},
  pdf         = {https://jerukan.github.io/spt-flux-probing/paper-pdfs/spt-flux-probing-paper-main.pdf},
  supp        = {https://jerukan.github.io/spt-flux-probing/paper-pdfs/spt-flux-probing-paper-supp.pdf},
  arxiv       = {2609.22479},
  video       = {https://youtu.be/Bk7LkLDpwV8},
  doi         = {10.1007/978-3-032-37020-4_8},
  abstract    = {Recovering high-speed video from sparse photon detections requires using structure across both space and time. Spatiotemporal flux probing estimates intensity dynamics directly from photon arrivals, enabling recovery of fast motion and changing illumination with fewer detections. The approach also supports velocity-selective video reconstruction and extends to event and spike camera measurements.}
}

@inproceedings{xie2026inter-photon-limited,
  abbr        = {CVPR},
  bibtex_show = {true},
  selected    = {true},
  title       = {Inter-{Photon}-{Limited} {Videography}},
  author      = {Xie, Andrew and Du, Dongyu and Nousias, Sotiris and Lindell, David B. and Kutulakos, Kiriakos N.},
  booktitle   = {Proceedings of the {IEEE}/{CVF} {Conference} on {Computer} {Vision} and {Pattern} {Recognition} ({CVPR})},
  year        = {2026},
  pages = {34006--34015},
  tags        = {high-speed-videography, low-light-imaging},
  website     = {https://www.dgp.toronto.edu/projects/inter-photon/},
  pdf         = {https://openaccess.thecvf.com/content/CVPR2026/papers/Xie_Inter-Photon-Limited_Videography_CVPR_2026_paper.pdf},
  abstract    = {We consider the problem of imaging a dynamic scene when scene appearance variations can outpace photon arrivals. Under such conditions, a pixel is effectively "blind" to changes in appearance that occur within the timespan separating the photons it detects, and so the inter-photon interval presents a significant speed barrier to video acquisition systems. To analyze and advance imaging capabilities at the inter-photon limit, we introduce a novel reparameterization of time-varying flux that reveals the intrinsic difficulty of signal reconstruction by relating the Fourier decomposition of a flux function to the number of photons arriving within each oscillation period. We find that inter-photon-limited videography of general scenes is underexplored and beyond the reach of existing reconstruction techniques. To this end, we introduce Neural Flux Fields---a technique that combines statistical modeling of photon arrival with intrinsic priors of a neural network to achieve robust videography at the inter-photon limit. Using this approach, we demonstrate never-before-seen capabilities in video reconstruction across a range of captured single-photon video datasets spanning the inter-photon-limited regime.}
}

@inproceedings{guo2026dark3r,
  abbr        = {CVPR},
  bibtex_show = {true},
  selected    = {true},
  title       = {Dark3R: Learning Structure from Motion in the Dark},
  author      = {Guo, Andrew Y. and Malik, Anagh and Tedla, SaiKiran and Dai, Yutong and Qin, Yiqian and Salehe, Zach and Attal, Benjamin and Nousias, Sotiris and Kutulakos, Kiriakos N. and Lindell, David B.},
  booktitle   = {Proceedings of the {IEEE}/{CVF} {Conference} on {Computer} {Vision} and {Pattern} {Recognition} ({CVPR})},
  year        = {2026},
  pages = {34160--34170},
  tags        = {3d-reconstruction, low-light-imaging},
  website     = {https://andrewyguo.github.io/dark3r_webpage/},
  pdf         = {https://openaccess.thecvf.com/content/CVPR2026/papers/Guo_Dark3R_Learning_Structure_from_Motion_in_the_Dark_CVPR_2026_paper.pdf},
  arxiv       = {2603.05330},
  abstract    = {We introduce Dark3R, a framework for structure from motion in the dark that operates directly on raw images with signal-to-noise ratios (SNRs) below -4 dB--a regime where conventional feature- and learning-based methods break down. Our key insight is to adapt large-scale 3D foundation models to extreme low-light conditions through a teacher-student distillation process, enabling robust feature matching and camera pose estimation in low light. Dark3R requires no 3D supervision; it is trained solely on noisy--clean raw image pairs, which can be either captured directly or synthesized using a simple Poisson-Gaussian noise model applied to well-exposed raw images.To train and evaluate our approach, we introduce a new, exposure-bracketed dataset that includes 42,000 multi-view raw images with ground-truth 3D annotations, and we demonstrate that Dark3R achieves state-of-the-art structure from motion in the low-SNR regime. Further, we demonstrate state-of-the-art novel view synthesis in the dark using Dark3R's predicted poses and a coarse-to-fine radiance field optimization procedure.}
}

@inproceedings{wei2023passive,
  abbr        = {ICCV},
  bibtex_show = {true},
  selected    = {true},
  award       = {Marr Prize (Best Paper Award)},
  title       = {Passive Ultra-Wideband Single-Photon Imaging},
  author      = {Wei*, Mian and Nousias*, Sotiris and Gulve, Rahul and Lindell, David B. and Kutulakos, Kiriakos N.},
  booktitle   = {Proceedings of the IEEE/CVF International Conference on Computer Vision (ICCV)},
  year        = {2023},
  tags        = {low-light-imaging, high-speed-videography},
  website     = {https://www.dgp.toronto.edu/projects/ultra-wideband/},
  pdf         = {https://openaccess.thecvf.com/content/ICCV2023/papers/Wei_Passive_Ultra-Wideband_Single-Photon_Imaging_ICCV_2023_paper.pdf},
  supp        = {https://openaccess.thecvf.com/content/ICCV2023/supplemental/Wei_Passive_Ultra-Wideband_Single-Photon_ICCV_2023_supplemental.zip},
  code        = {https://github.com/t-cig/UWB1D},
  video       = {https://www.dgp.toronto.edu/projects/ultra-wideband/static/docs/supp/iccv-final.mp4},
  doi         = {10.1109/ICCV51070.2023.00747},
  abstract    = {A free-running single-photon camera can record changing light over timescales from ordinary motion to ultrafast events without synchronizing to a source. This work develops a flux-probing model and a Fourier-domain reconstruction method for sparse photon timestamps, then demonstrates passive video capture across a very wide range of temporal frequencies.}
}

@inproceedings{malik2023transient,
  abbr        = {NeurIPS},
  bibtex_show = {true},
